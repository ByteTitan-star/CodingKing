# OpenAI Compatible（DeepSeek / GLM / Qwen / Ollama / 任意兼容网关）
CODERKING_OPENAI_BASE_URL=https://api.deepseek.com/v1
CODERKING_OPENAI_API_KEY=sk-your-key
CODERKING_MODEL=deepseek-chat

# 推理模型必须关闭 thinking，否则小 max_tokens 会得到空 content
CODERKING_DISABLE_THINKING=true

# auto | docker | local（local 仅为 development fallback）
CODERKING_SANDBOX_MODE=auto
CODERKING_SANDBOX_TIMEOUT_SEC=120
CODERKING_SANDBOX_MEMORY_MB=512
CODERKING_SANDBOX_CPUS=1.0
CODERKING_SANDBOX_NETWORK=false

CODERKING_MAX_ITERATIONS=24

# 长会话上下文管理
CODERKING_CONTEXT_WINDOW=128000
CODERKING_COMPRESSION_ENABLED=true
CODERKING_COMPRESSION_THRESHOLD=0.75
CODERKING_COMPRESSION_RESERVE_TOKENS=4096
CODERKING_COMPRESSION_KEEP_RECENT_MESSAGES=20

# 可选资源默认关闭；MCP 还需要 .coderking/mcp.json allowlist
CODERKING_DYNAMIC_TOOLS_ENABLED=false
CODERKING_MCP_ENABLED=false
CODERKING_MCP_TIMEOUT_SEC=60

CODERKING_ALLOW_COMMIT=false
CODERKING_WORKSPACE=.
